{
  "name": "pikibun",
  "version": "0.9.0",
  "description": "Connect your Linux or WSL2 Pi host to a Pikibun workspace, or run Pikibun on your own computer.",
  "license": "MIT",
  "homepage": "https://pikibun.com",
  "repository": { "type": "git", "url": "git+https://github.com/OpenCara/pikibun.git", "directory": "packages/cli" },
  "keywords": ["pikibun", "pi", "agent", "connector", "server"],
  "type": "module",
  "bin": { "pikibun": "dist/pikibun.js" },
  "files": ["dist", "npm-shrinkwrap.json"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "shrinkwrap": "node scripts/shrinkwrap.mjs",
    "prepublishOnly": "node scripts/shrinkwrap.mjs --check && pnpm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@hono/node-server": "1.19.11",
    "hono": "4.12.8",
    "ws": "8.21.0",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "koffi": "3.3.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
