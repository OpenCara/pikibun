{
  "name": "Pikibun",
  "id": "com.pikibun.app",
  "version": "0.1.0",
  "build": 1,
  "icon": "icon.png",
  "schemes": ["pikibun"],
  "capabilities": {
    "network": { "hosts": ["*"] },
    "webview": { "hosts": ["*"] },
    "clipboard": true,
    "picker": true,
    "openUrl": true,
    "statusBar": true,
    "notifications": true,
    "fs": { "read": ["${homeDir}", "${dataDir}/updates", "${dataDir}/cli"], "write": ["${dataDir}/updates"] },
    "process": {
      "execute": ["zsh", "bash", "sh", "cmd", "schtasks"],
      "exit": true,
      "env": [
        "SHELL", "USER", "LOGNAME", "TERM", "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME",
        "PATHEXT", "ComSpec", "APPDATA", "LOCALAPPDATA", "ProgramFiles", "ProgramData", "SystemDrive", "windir", "USERNAME", "USERDOMAIN", "COMPUTERNAME",
        "DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
        "PIKIBUN_MXC_RUNTIME"
      ]
    },
    "host": ["page.*"]
  },
  "web": { "host": "./web/host.js" }
}
