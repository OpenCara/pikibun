{
  "name": "Pikibun",
  "id": "com.pikibun.app",
  "version": "0.1.0",
  "build": 1,
  "icon": "icon.png",
  "capabilities": {
    "network": { "hosts": ["*"] },
    "webview": { "hosts": ["*"] },
    "clipboard": true,
    "picker": true,
    "openUrl": true,
    "statusBar": true,
    "fs": { "read": ["${homeDir}"] },
    "process": {
      "execute": ["zsh", "bash", "sh", "cmd"],
      "env": [
        "SHELL", "USER", "LOGNAME", "TERM", "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME",
        "PATHEXT", "ComSpec", "APPDATA", "LOCALAPPDATA", "ProgramFiles", "ProgramData", "SystemDrive", "windir", "USERNAME", "COMPUTERNAME",
        "PIKIBUN_MXC_RUNTIME"
      ]
    },
    "host": ["page.*"]
  },
  "web": { "host": "./web/host.js" }
}
