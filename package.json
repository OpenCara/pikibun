{
  "name": "@opencara/pikibun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:preview": "node scripts/nsh.mjs run",
    "dev:server": "node --env-file-if-exists=apps/server/.env --import tsx apps/server/src/main.ts",
    "dev:runner": "node --env-file-if-exists=apps/runner/.env --import tsx apps/runner/src/index.ts",
    "dev:native": "node --import tsx scripts/dev-native.ts",
    "connect": "node --import tsx packages/cli/src/pikibun.ts connect",
    "build": "pnpm build:web && pnpm build:preview",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:preview": "node scripts/nsh.mjs --build-web dist/preview",
    "build:server": "esbuild apps/server/src/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server/main.js && rm -rf dist/server/migrations && cp -R apps/server/migrations dist/server/migrations",
    "build:cli": "pnpm run build && pnpm --filter pikibun run build",
    "nsh": "node scripts/nsh.mjs",
    "test:client": "node scripts/nsh.mjs test",
    "test:client-live": "node --import tsx scripts/nsh-live.ts",
    "test:client-web": "node --import tsx scripts/web-smoke.ts",
    "test:web": "node --import tsx scripts/web-smoke.ts --react",
    "test:client-macos": "node --import tsx scripts/nsh-macos-smoke.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @pikibun/desktop typecheck && node scripts/nsh.mjs check",
    "python:embed": "node scripts/embed-python.mjs",
    "python:check": "node scripts/check-python.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:connected": "node --import tsx tests/run-connected-integration.ts",
    "start": "node --env-file-if-exists=apps/server/.env --import tsx apps/server/src/main.ts",
    "db:migrate": "node --env-file-if-exists=apps/server/.env --import tsx apps/server/src/main.ts --migrate-only",
    "db:dump": "node --env-file-if-exists=apps/server/.env --import tsx apps/server/src/main.ts --dump",
    "db:import": "node --env-file-if-exists=apps/server/.env --import tsx apps/server/src/main.ts --import-dump"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@hono/node-server": "1.19.11",
    "hono": "4.12.8",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.21.0",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "koffi": "3.3.5"
  },
  "devDependencies": {
    "@astral-sh/ruff-wasm-nodejs": "0.17.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "lowlight": "3.3.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "pyright": "1.1.414",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
